      "id": "bug-032",
      "timestamp": "2026-04-12T00:00:00.000Z",
      "error_message": "Login → dashboard → login redirect loop: after successful login, dashboard immediately redirects back to login.html",
      "file": "frontend/api.js",
      "root_cause": "check401() unconditionally cleared JWT + redirected on ANY 401 response. When Proxy Lambda returns 401 due to JWT_SECRET mismatch (config error), check401() fired even though the token was still valid, creating an infinite redirect loop.",
      "fix": "check401() now decodes JWT payload, checks exp claim (with proper base64url → base64 char replacement before atob()), and only redirects when token is genuinely expired. Non-expired token + 401 = server config error; logs warning, returns without redirecting.",
      "tags": [
        "auth",
        "redirect-loop",
        "check401",
        "jwt",
        "proxy",
        "frontend"
      ],
      "related_bugs": [
        "bug-031"
      ],
