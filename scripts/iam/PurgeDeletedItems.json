{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/PurgeDeletedItems",
        "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/PurgeDeletedItems:*"
      ]
    },
    {
      "Sid": "InventoryIQ",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/InventoryIQ"
      ]
    },
    {
      "Sid": "JobsDLQ",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:sqs:${Region}:${AccountId}:panindo-jobs-dlq"
      ]
    }
  ]
}
