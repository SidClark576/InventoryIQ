{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/OrgMembers",
        "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/OrgMembers:*"
      ]
    },
    {
      "Sid": "OrgMembers",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/OrgMembers"
      ]
    },
    {
      "Sid": "OrgInvites",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/OrgInvites",
        "arn:aws:dynamodb:${Region}:${AccountId}:table/OrgInvites/index/*"
      ]
    },
    {
      "Sid": "Organizations",
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/Organizations"
      ]
    }
  ]
}
