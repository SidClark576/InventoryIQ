{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/OrgInvites",
        "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/OrgInvites:*"
      ]
    },
    {
      "Sid": "OrgInvites",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/OrgInvites",
        "arn:aws:dynamodb:${Region}:${AccountId}:table/OrgInvites/index/*"
      ]
    },
    {
      "Sid": "Organizations",
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/Organizations"
      ]
    },
    {
      "Sid": "OrgMembers",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/OrgMembers"
      ]
    },
    {
      "Sid": "SendEmail",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail"
      ],
      "Resource": [
        "arn:aws:ses:${Region}:${AccountId}:identity/*"
      ]
    }
  ]
}
