{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/DailyAlert",
        "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/DailyAlert:*"
      ]
    },
    {
      "Sid": "InventoryIQ",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/InventoryIQ",
        "arn:aws:dynamodb:${Region}:${AccountId}:table/InventoryIQ/index/*"
      ]
    },
    {
      "Sid": "Organizations",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/Organizations"
      ]
    },
    {
      "Sid": "AlertsTopic",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": [
        "arn:aws:sns:${Region}:${AccountId}:InventoryIQ-Alerts"
      ]
    },
    {
      "Sid": "JobsDLQ",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:sqs:${Region}:${AccountId}:panindo-jobs-dlq"
      ]
    }
  ]
}
