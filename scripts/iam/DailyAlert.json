{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/DailyAlert",
        "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/DailyAlert:*"
      ]
    },
    {
      "Sid": "InventoryIQ",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/InventoryIQ"
      ]
    },
    {
      "Sid": "AlertsTopic",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": [
        "arn:aws:sns:${Region}:${AccountId}:InventoryIQ-Alerts"
      ]
    }
  ]
}
