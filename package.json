{
  "name": "inventoryiq-e2e",
  "version": "1.0.0",
  "description": "E2E tests for InventoryIQ",
  "scripts": {
    "dev": "vite --port 8000",
    "dev:local": "bash scripts/dev_local.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8000",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/unit/ts/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1158.0",
    "@aws-sdk/client-ses": "^3.1158.0",
    "@aws-sdk/lib-dynamodb": "^3.1158.0",
    "@playwright/test": "^1.40.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/aws-serverless": "^10.55.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  }
}
